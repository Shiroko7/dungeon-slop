# ── Dungeon generation (architect + narrator passes) ─────────────────────────
GEMINI_API_KEY=

# ── Notes: ingest summaries + embeddings ─────────────────────────────────────
# One OpenAI-compatible code path. Switching provider is two variables.
#
#   gemini      free tier, serves BOTH chat and embeddings from one key   ← default
#   openrouter  one key, routes to anything; best paid target
#   deepseek    cheapest capable direct API; cache hits ~31x below misses
#   openai      GPT-5.6 Luna + text-embedding-3-small
#   groq        fast, open-weight only, 6k tokens/min free — too small for this
NOTES_PROVIDER=gemini

# Only needed when NOT using the provider above
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# ── Optional overrides ───────────────────────────────────────────────────────
# NOTES_SUMMARY_MODEL=gemini-flash-latest
# NOTES_EMBEDDING_MODEL=gemini-embedding-001
# NOTES_DB_PATH=notes.sqlite

# OpenRouter and DeepSeek do not serve embeddings — point them elsewhere:
# NOTES_EMBEDDING_PROVIDER=gemini

# Voyage is a separate client (it distinguishes document vs query embeddings).
# voyage-4-lite is $0.02/1M with the first 200M tokens free.
# NOTES_EMBEDDING_PROVIDER=voyage
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-4-lite

# Anthropic path is still available (createAnthropicSummarizer, Batch API).
# ANTHROPIC_API_KEY=
