{
  "name": "dungeon-slop",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"bun run api\" \"bun x --bun vite\"",
    "api": "bun run --hot src/server.ts",
    "start": "bun run src/server.ts",
    "build": "bun x --bun vite build",
    "preview": "bun x --bun vite preview",
    "test": "bun test",
    "eval:retrieval": "bun run src/notes/eval/evaluate.ts",
    "dungeon": "bun run scripts/dungeon.ts",
    "assets": "bun run scripts/assets.ts",
    "map-art": "bun run scripts/map-art.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "jspdf": "^4.2.1",
    "pngjs": "^7.0.0",
    "polybooljs": "^1.2.2",
    "react": "^19",
    "react-dom": "^19",
    "roughjs": "^4.6.6",
    "zod": "^4.6.6",
    "zustand": "^5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
